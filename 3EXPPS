clc;
close all;
clear all;

linedata=[1 2   0.026   0.11
    1   3   0.026   0.11
    2   3   0.026   0.11];
ych=j*0.04;
nl=linedata(:,1);
nr=linedata(:,2);
R=linedata(:,3);
X=linedata(:,4);
nbr=length(linedata(:,1));
nbuses=max(max(nl),max(nr));
Z=R+j*X;
y=ones(nbr,1)/Z;
Ybus=zeros(nbuses,nbuses);

for k=1:nbr
    if nl(k) > 0 && nr(k)>0
        Ybus(nl(k),nr(k))=Ybus(nl(k),nr(k))-y(k);
        Ybus(nr(k),nl(k))=Ybus(nl(k),nr(k));
    end
end
for n=1:nbuses
    for k=1:nbr
        if nl(k)==n||nr(k)==n
            Ybus(n,n)=Ybus(n,n)+y(k)+ych;
        else
        end
    end
end

busdata=[1  1   1.03    0   0   0   0   0   0   0
    2   2   1.03    0   1.5 0   0   0   0.1 0.5
    3   3   1   0   0   0   1.2 0.5 0   0 ];
bus=busdata(:,1);
type=busdata(:,2);
V=busdata(:,3);
th=busdata(:,4);
GenMW=busdata(:,5);
GenMVAR=busdata(:,6);
LoadMW=busdata(:,7);
LoadMVAR=busdata(:,8);
Qmin=busdata(:,9);
Qmax=busdata(:,10);
nbus=max(bus);
P=GenMW-LoadMW;
Q=GenMVAR-LoadMVAR;
Vprep=V;
toler=1;
iteration=0;
while(toler>0.00001)
    for i=2:nbus
        sumyv=0;
        for k=1:nbus
            if i ~=k
                sumyv=sumyv+Ybus(i,k)*V(k);
            end
        end
        if type(i)==2
            Q(i)=-imag(conj(V(i)) *(sumyv+Ybus(i,i)*V(i)));
        if(Q(i) > Qmax(i)) || (Q(i)<Qmin(i))
            if Q(i)<Qmin(i)
                Q(i)=Qmin(i);
            else
                Q(i)=Qmax(i);
            end
            type(i)=3;
        end
        end
        V(i)=(1/Ybus(i,i))*((P(i)-j*Q(i))/conj(V(i))-sumyv);
        if type(i)==2
            r=abs(Vprep(i));
        end
    end
    iteration=iteration+1;
    toler=max(abs(abs(V)-abs(Vprep)));
    Vprep=V;
    angle(V((i)));
end

disp('VALUE AT FINAL ITERATION');
disp('VALUE ARRIVED AT ITERATION NUMBER');
disp(iteration);
V;
Vmag=abs(V);
Ang=180/pi*angle(V);
disp('HACKER49');
disp('Gauss Seidel Load-Flow Study');
disp('HACKER49');
disp('Bus Voltage Angle');
disp('no Volts Degree');
ywz=[bus(:,1) Vmag Ang];
disp(ywz);
disp('HACKER49');



